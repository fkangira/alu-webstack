global
    log /dev/log local0
    log /dev/log local1 notice
    maxconn 2048
    user haproxy
    group haproxy
    daemon
    h1-case-adjust x-served-by X-Served-By
    h1-case-adjust server Server
    h1-case-adjust date Date
    h1-case-adjust content-type Content-Type
    h1-case-adjust content-length Content-Length
    h1-case-adjust last-modified Last-Modified
    h1-case-adjust etag ETag
    h1-case-adjust connection Connection
    h1-case-adjust accept-ranges Accept-Ranges

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000
    timeout client  50000
    timeout server  50000

frontend http_front
    option h1-case-adjust-bogus-client
    bind *:80
    default_backend http_back

frontend https_front
    option h1-case-adjust-bogus-client
    bind *:443 ssl crt /etc/haproxy/certs/www.fanuelkangira.tech.pem
    http-request set-header X-Forwarded-Proto https
    default_backend http_back

backend http_back
    balance roundrobin
    server 7204-web-01 18.133.239.146:80 check
    server 7204-web-02 35.177.254.240:80 check
